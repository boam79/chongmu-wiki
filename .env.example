NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Required in production (Vercel + Supabase Edge Function secrets)
ADMIN_UPLOAD_SECRET=openssl_rand_base64_32

# ISR on-demand revalidate — POST /api/revalidate
REVALIDATE_SECRET=openssl_rand_base64_32
VERCEL_REVALIDATE_TOKEN=same_as_REVALIDATE_SECRET
VERCEL_PROJECT_URL=https://chongmu-wiki.vercel.app
